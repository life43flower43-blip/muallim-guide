// قاعدة بيانات «تربوي» — الحسابات والجواهر والأخطاء والتقدم
// نُقلت بنيتها من تطبيق أوريندو (حسابات Google/البريد، دفتر الجواهر، عناصر المراجعة)
// بلا ما يخص تعليم اللغة. بنك الأسئلة نفسه ملف ثابت (public/data/qbank.json)،
// فالجداول تحفظ معرّف السؤال فقط.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  password     String? // مجزّأة بـ bcrypt — فارغة لحسابات Google
  avatar       String?
  xp           Int      @default(0)
  streak       Int      @default(0)
  streakFreeze Int      @default(0)
  gems         Int      @default(0)
  tokenVersion Int      @default(0) // يزيد لإبطال كل الجلسات
  emailOptIn   Boolean  @default(false) // يوافق على الملخص الأسبوعي بالبريد
  emailVerified DateTime? // متى أكد المستخدم ملكية بريده
  lastDigestAt DateTime? // آخر ملخص أُرسل إليه
  lastActive   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  oauthAccounts     OAuthAccount[]
  gemTransactions   GemTransaction[]
  gemMigrationFlags GemMigrationFlag[]
  reviewItems       ReviewItem[]
  progress          UserProgress?
}

// يربط المستخدم بحساب Google (مستخدم واحد يمكن أن يربط أكثر من مزوّد)
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String // "google"
  providerAccountId String
  email             String
  name              String?
  picture           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([email, provider])
}

// دفتر الجواهر: كل منح أو صرف سطر واحد، والمفتاح الفريد يمنع احتسابه مرتين
model GemTransaction {
  id             String   @id @default(cuid())
  userId         String
  amount         Int
  type           String // "award" | "spend"
  reason         String
  idempotencyKey String   @unique
  balanceAfter   Int
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// فرق كبير بين جواهر الجهاز وجواهر الحساب عند تسجيل الدخول — يُسجَّل ولا يُدمج
model GemMigrationFlag {
  id               String   @id @default(cuid())
  userId           String
  dbGems           Int
  localStorageGems Int
  diff             Int
  flaggedAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, flaggedAt])
}

// خطأ في سؤال من البنك، يُراجع بالتكرار المتباعد (SM-2)
model ReviewItem {
  id           String    @id @default(cuid())
  userId       String
  questionId   String
  easeFactor   Float     @default(2.5)
  interval     Int       @default(1)
  repetitions  Int       @default(0)
  nextReview   DateTime  @default(now())
  lastReview   DateTime?
  mistakeCount Int       @default(0)
  isCorrect    Boolean   @default(false)
  userAnswer   String?
  source       String    @default("practice")
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, nextReview])
}

// نسخة من تقدم الجهاز (المحاولات والجلسات وأفضل النتائج) تُزامن بين الأجهزة
model UserProgress {
  userId    String   @id
  data      String // JSON
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// اشتراك جهاز في الإشعارات: التذكير اليومي بالدراسة وبالأخطاء المستحقة.
// يُحفظ للضيف أيضًا (بلا مستخدم)، ويُعرف يوم دراسته من الجهاز نفسه.
model PushSubscription {
  id           String   @id @default(cuid())
  endpoint     String   @unique
  p256dh       String
  auth         String
  userId       String?
  tzOffset     Int      @default(0) // دقائق فرق التوقيت كما يعطيها getTimezoneOffset
  lastStudyDay String? // آخر يوم درس فيه بتوقيت الجهاز YYYY-MM-DD
  lastSentDay  String? // آخر يوم أُرسل فيه تذكير، لئلا يتكرر في اليوم نفسه
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

/// ما نشره بوت تيليجرام: مفتاح واحد لكل يوم وموعد، فلا يُنشر الموعد نفسه مرتين
model TelegramPost {
  key       String   @id // مثل 2026-11-04:tip
  createdAt DateTime @default(now())
}

/// حسابات النشر الآلي في المنصات (صفحة فيسبوك، لينكدإن...). صف واحد لكل منصة.
/// أول من يربط المنصة يصبح مالكها، ولا يستبدل الربطَ غيرُه (ownerId).
model SocialAccount {
  platform  String    @id // facebook | linkedin
  ownerId   String // معرّف المستخدم في المنصة الذي ربطها أول مرة
  accountId String // معرّف الصفحة أو الحساب الذي يُنشر فيه
  name      String
  token     String
  expiresAt DateTime?
  lastAt    DateTime? // آخر محاولة نشر
  lastOk    Boolean? // هل نجحت
  lastError String? // رسالة الخطأ إن فشلت، تُعرض في صفحة /connect
  updatedAt DateTime  @updatedAt
}

/// رموز استعادة كلمة المرور: رمز واحد صالح ساعة، يُحذف بعد الاستخدام
model PasswordReset {
  token     String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// بلاغات «خطأ في السؤال» من الطلاب: بلاغ واحد لكل سؤال من كل مُبلِّغ
model QuestionReport {
  id         String   @id @default(cuid())
  questionId String
  reporter   String // معرّف الحساب، أو بصمة العنوان للضيف
  createdAt  DateTime @default(now())

  @@unique([questionId, reporter])
  @@index([questionId])
}

/// أعطال الواجهة عند المستخدمين: سجل واحد لكل عطل متكرر (بصمة الرسالة والمكان) مع عدّاد
model ClientError {
  id        String   @id // بصمة الرسالة والمكان والإصدار
  message   String
  stack     String?
  url       String?
  version   String?
  ua        String?
  count     Int      @default(1)
  firstAt   DateTime @default(now())
  lastAt    DateTime @default(now())

  @@index([lastAt])
}

// عدّادات حدود الطلبات الحساسة (الدخول والتسجيل والاستعادة) مشتركة بين كل خوادم Vercel
model RateHit {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@index([resetAt])
}

// روابط تأكيد البريد: «verify» لتأكيد بريد الحساب، و«change» لاعتماد بريد جديد
model EmailToken {
  token     String   @id
  userId    String
  kind      String
  newEmail  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}
